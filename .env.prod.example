# 운영 배포 설정 — 서버에서 `cp .env.prod.example .env.prod` 후 값을 채운다.
# .env.prod는 커밋하지 않는다(.gitignore).

# 접속 주소(https:// 없이). 이 이름으로 Let's Encrypt 인증서를 받으므로 DNS가 서버 공인 IP를
# 가리키고 있어야 한다. 도메인이 없을 때는 IP로 만든 sslip.io 주소를 쓸 수 있다:
#   공인 IP가 1.2.3.4면 → 1-2-3-4.sslip.io
DOMAIN=example.com

POSTGRES_USER=coin_autotrading
POSTGRES_DB=coin_autotrading
# 무작위 값으로 바꿀 것: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# 필수 — 비어 있으면 기동하지 않는다. openssl rand -hex 32
# 바꾸면 기존 로그인 토큰이 전부 무효가 된다(모두 다시 로그인).
JWT_SECRET_KEY=
