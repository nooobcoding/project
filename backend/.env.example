DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/coin_autotrading
# 필수값 — 미설정 시 서버가 기동하지 않는다. 배포 환경에서는 반드시 임의의 긴
# 무작위 문자열로 교체할 것 (예: openssl rand -hex 32).
JWT_SECRET_KEY=change-me
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 확장판 00-architecture.md 2.1절 — 생략하면 전 역할 활성(지금과 동일한 단일 프로세스).
# 운영에서 역할을 나눌 때만 프로세스별로 부분집합을 지정한다.
# PROCESS_ROLES=api,market-data,matcher,worker,scheduler
# 확장판 02-market-data.md 5장 — 생략하면 memory(단일 프로세스, Redis 불필요). 프로세스를
# 나누기 시작하면 redis로 전환한다.
# PRICE_CACHE_BACKEND=redis
# REDIS_URL=redis://localhost:6379/0
# PRICE_MAX_AGE_SECONDS=30
# 확장판 04-async-jobs.md 3.2절 — Upbit REST 토큰 버킷. 생략하면 보수적인 기본값을 쓴다.
# 총량을 고우선(scheduler 캔들 채우기)과 저우선(백테스트)이 나눠 갖는다.
# UPBIT_REST_TOKENS_PER_SECOND=8
# UPBIT_REST_BURST=10
# UPBIT_REST_HIGH_SHARE=0.6
# UPBIT_REST_WAIT_TIMEOUT_SECONDS=30
# UPBIT_REST_THROTTLE_BACKOFF_SECONDS=60
